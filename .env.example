# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — required for Google Calendar sync when clients book/cancel
SUPABASE_SERVICE_ROLE_KEY=

# Owner phone shown on the About page (hidden when unset)
NEXT_PUBLIC_OWNER_PHONE=

# Production site URL (required for email confirmation links)
NEXT_PUBLIC_SITE_URL=https://nailsbygabs.org

# Google Calendar sync (owner only) — optional
# Create OAuth credentials at https://console.cloud.google.com
# Authorized redirect URI: https://nailsbygabs.org/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Owner booking email notifications (Resend — free tier, no credit card for dev)
# https://resend.com — 3,000 emails/month free
RESEND_API_KEY=
# One line only — no line breaks inside the address
RESEND_FROM_EMAIL=NailsByGabs <onboarding@resend.dev>
# Optional override; else uses app_config owner_notification_email, then owner_email
OWNER_NOTIFICATION_EMAIL=

# Vercel Cron (Hobby: once per day only) — marks completed appointments and
# sends 48-hour client reminder emails for upcoming platform bookings.
# Runs daily at 13:00 UTC (~9am Eastern). For hourly runs, use an external
# scheduler (e.g. cron-job.org) to GET /api/cron/appointment-lifecycle with
# Authorization: Bearer <CRON_SECRET>, or upgrade to Vercel Pro.
CRON_SECRET=

# Local development only (ignored in production builds): send booking emails to
# the Mailpit inbox that `npx supabase start` runs, instead of Resend.
# DEV_MAILPIT_URL=http://127.0.0.1:54324
