# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — required for Google Calendar sync when clients book/cancel
SUPABASE_SERVICE_ROLE_KEY=

# Production site URL (required for email confirmation links)
NEXT_PUBLIC_SITE_URL=https://nailsbygabs.org

# Google Calendar sync (owner only) — optional
# Create OAuth credentials at https://console.cloud.google.com
# Authorized redirect URI: https://nailsbygabs.org/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Owner booking email notifications (Resend — free tier, no credit card for dev)
# https://resend.com — 3,000 emails/month free
RESEND_API_KEY=
# One line only — no line breaks inside the address
RESEND_FROM_EMAIL=NailsByGabs <onboarding@resend.dev>
# Optional override; else uses app_config owner_notification_email, then owner_email
OWNER_NOTIFICATION_EMAIL=

# Vercel Cron — secures /api/cron/appointment-lifecycle (hourly completion marking)
CRON_SECRET=
