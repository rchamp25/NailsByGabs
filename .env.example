# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Production site URL (required for email confirmation links)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Google Calendar sync (owner only) — optional
# Create OAuth credentials at https://console.cloud.google.com
# Authorized redirect URI: https://your-app.vercel.app/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Owner booking email notifications (Resend — free tier, no credit card for dev)
# https://resend.com — 3,000 emails/month free
RESEND_API_KEY=
RESEND_FROM_EMAIL=NailsByGabs <onboarding@resend.dev>
# Optional; defaults to owner_email in Supabase app_config
OWNER_NOTIFICATION_EMAIL=
